# ANARCHY Voice — copy this file to .env and fill it in.
# Never commit .env: it holds your bot token.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Default name for a new room. {user} = display name, {tag} = username
VC_NAME_TEMPLATE={user}

# Minimum time between two rooms created by the same person, in milliseconds
CREATE_COOLDOWN_MS=5000

# SQLite database file (custom panel banners are stored next to it in panels/)
DB_PATH=./data/anarchyvoice.db

# Lobby, category and panel are not configured here: run /setup in Discord.
